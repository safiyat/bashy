
COMPLETION_FILES=(
"/etc/bash_completion"
)

COMPLETION_DIRS=(
"/etc/bash_completion.d"
"/opt/homebrew/share/bash-completion/completions"
)


for completion_file in ${COMPLETION_FILES[@]}; do
    # if [ -f "${completion_file}" ] && ! shopt -oq posix; then
    if [ -f "${completion_file}" ]; then
        . "${completion_file}"
    fi
done

for completion_dir in ${COMPLETION_DIRS[@]}; do
    if [ -d "${completion_dir}" ]; then
        for completion in $(find "${completion_dir}" -not -path '*/.*' -type f); do
            test -x ${completion} && . ${completion}
        done
    fi
done


# Completions for kubectl
if which kubectl > /dev/null; then
    source <(kubectl completion bash)
fi

# pipx completions
if command -v pipx > /dev/null; then
    eval "$(register-python-argcomplete pipx)"
fi

# iterm2 integration
test -e "${HOME}/.iterm2_shell_integration.bash" && source "${HOME}/.iterm2_shell_integration.bash"

# Completions for limactl
if which limactl > /dev/null; then
    source <(limactl completion bash)
fi
